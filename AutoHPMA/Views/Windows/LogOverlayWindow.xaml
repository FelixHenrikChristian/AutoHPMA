<winex:WindowEx
    x:Class="AutoHPMA.Views.Windows.LogOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:AutoHPMA.Helpers"
    xmlns:winex="using:WinUIEx"
    Width="400"
    Height="300"
    Title="LogOverlayWindow">

    <Grid x:Name="RootHost" IsHitTestVisible="False">
        <Grid.Resources>
            <helpers:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter" />
        </Grid.Resources>

        <Border
            Margin="8"
            Padding="0"
            CornerRadius="10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#50000000" Offset="0" />
                    <GradientStop Color="#70000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel Margin="12,10,12,10">
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <Border
                        Padding="8,4,8,4"
                        VerticalAlignment="Center"
                        Background="#2520D8E8"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Foreground="#80E0FF"
                                Glyph="&#xE121;" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#B0E0FF"
                                Text="{Binding TimeNow}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="6,0,0,0"
                        Padding="8,4,10,4"
                        VerticalAlignment="Center"
                        Background="#2520D8E8"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Foreground="#80E0FF"
                                Glyph="&#xE9D5;" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#B0E0FF"
                                Text="{Binding CurrentGameState}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Height="1" Margin="0,0,0,6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0" />
                            <GradientStop Color="#4080E0FF" Offset="0.2" />
                            <GradientStop Color="#4080E0FF" Offset="0.8" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <ListView
                    x:Name="LogListView"
                    Width="360"
                    Height="230"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Entries}"
                    SelectionMode="None"
                    ShowsScrollingPlaceholders="False"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="26" />
                            <Setter Property="Height" Value="26" />
                            <Setter Property="Margin" Value="0,1,0,1" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="6,3,6,3"
                                Background="#10FFFFFF"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Padding="4,1,4,1"
                                        VerticalAlignment="Center"
                                        Background="#20808080"
                                        CornerRadius="3">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="#B0B0B0"
                                            Text="{Binding ShortTimeText}" />
                                    </Border>

                                    <Border
                                        Grid.Column="1"
                                        Margin="4,0,6,0"
                                        Padding="5,1,5,1"
                                        VerticalAlignment="Center"
                                        Background="#2080C0FF"
                                        CornerRadius="3">
                                        <TextBlock
                                            FontFamily="Cascadia Mono"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}"
                                            Text="{Binding LevelText}" />
                                    </Border>

                                    <Grid
                                        x:Name="MessageClipHost"
                                        Grid.Column="2"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        SizeChanged="OnMessageClipHostSizeChanged">
                                        <Canvas
                                            x:Name="MarqueeCanvas"
                                            Height="20"
                                            HorizontalAlignment="Stretch">
                                            <TextBlock
                                                x:Name="MarqueeText"
                                                Canvas.Top="2"
                                                FontSize="12"
                                                Foreground="#E8E8E8"
                                                Loaded="OnMessageTextLoaded"
                                                DataContextChanged="OnMessageTextDataContextChanged" />
                                        </Canvas>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</winex:WindowEx>
