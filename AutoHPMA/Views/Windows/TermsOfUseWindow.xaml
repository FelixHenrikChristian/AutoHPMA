<ui:FluentWindow x:Class="AutoHPMA.Views.Windows.TermsOfUseWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="使用条款"
                 Height="560"
                 Width="520"
                 MinHeight="420"
                 MinWidth="400"
                 ResizeMode="CanResizeWithGrip"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏仅保留窗口控制；主标题在正文区放大，避免与「欢迎使用」字号倒挂 -->

        <ScrollViewer x:Name="TermsScrollViewer"
                      Grid.Row="1"
                      Margin="24,8,10,8"
                      Padding="0,0,14,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="TermsScrollViewer_ScrollChanged">
            <StackPanel>
                <ui:TextBlock FontTypography="Title"
                              Text="使用条款"
                              TextWrapping="Wrap"
                              Margin="0,0,0,8" />
                <ui:TextBlock FontTypography="BodyStrong"
                              Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                              Text="欢迎使用 AutoHPMA"
                              TextWrapping="Wrap"
                              Margin="0,0,0,10" />
                <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"
                              LineHeight="22"
                              Margin="0,0,0,20"
                              Text="在继续使用前，请阅读并理解以下条款。点击「同意并继续」即表示您接受全部内容。" />

                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="1"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="12" />
                            </Border>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Text="用途与许可"
                                          VerticalAlignment="Center"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:TextBlock TextWrapping="Wrap"
                                      LineHeight="24"
                                      Text="本软件免费开源，仅供学习和研究使用，旨在为学术和研究人员提供参考和资料，任何其他目的均不适用。" />
                    </StackPanel>
                </Border>

                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="2"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="12" />
                            </Border>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Text="禁止行为与责任"
                                          VerticalAlignment="Center"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:TextBlock TextWrapping="Wrap"
                                      LineHeight="24"
                                      Text="严禁将本软件用于任何商业或非法用途。对于因违反此规定而产生的任何法律后果，用户需自行承担全部责任。" />
                    </StackPanel>
                </Border>

                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="3"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="12" />
                            </Border>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Text="资源与版权"
                                          VerticalAlignment="Center"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:TextBlock TextWrapping="Wrap"
                                      LineHeight="24"
                                      Text="软件目录下的资源信息均来源于网络。如有关于版权的争议或问题，请联系原作者或权利人。" />
                    </StackPanel>
                </Border>

                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="4"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="12" />
                            </Border>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Text="免责声明"
                                          VerticalAlignment="Center"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:TextBlock TextWrapping="Wrap"
                                      LineHeight="24"
                                      Text="由于用户计算机软硬件环境的差异性和复杂性，本软件所提供的各项功能并不能保证在任何情况下都能正常执行或达到用户所期望的结果。用户使用本软件所产生的一切后果，软件作者不承担任何责任。" />
                    </StackPanel>
                </Border>

                <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              FontSize="12"
                              LineHeight="20"
                              TextWrapping="Wrap"
                              Margin="2,4,0,8"
                              Text="若您不同意上述任一条款，请关闭本窗口并退出应用程序。" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Margin="24,12">
                <ui:InfoBar x:Name="ReadToEndInfoBar"
                            Title="提示"
                            Message="请仔细阅读使用条款。"
                            Severity="Informational"
                            IsOpen="False"
                            IsClosable="True"
                            Margin="0,0,0,10" />

                <!-- 允许捕获“点到被禁用按钮区域”的意图，但不改变按钮禁用状态 -->
                <Grid PreviewMouseLeftButtonDown="BottomBar_PreviewMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <ui:Button Content="退出"
                                   Margin="0,0,8,0"
                                   Click="ExitButton_Click" />
                        <ui:Button x:Name="AgreeButton"
                                   Appearance="Primary"
                                   Content="同意并继续"
                                   Icon="{ui:SymbolIcon Checkmark24}"
                                   IsEnabled="False"
                                   Click="AgreeButton_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
