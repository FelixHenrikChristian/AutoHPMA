<Page
    x:Class="AutoHPMA.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnLoaded">

    <StackPanel x:Name="ContentArea">
            <!-- 应用设置 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <FontIcon
                    Margin="0,0,8,0"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="18"
                    Glyph="&#xE713;" />
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="应用设置"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- 切换主题 -->
            <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="20"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE771;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Text="切换主题" TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="在浅色与暗色主题间进行切换，默认为系统主题"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="2"
                        MinWidth="120"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedThemeOption, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 阻止休眠 -->
            <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="20"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE7F4;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Text="阻止休眠" TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="开启后，在程序运行期间推迟显示器关闭与因空闲触发的系统睡眠"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="2"
                        MinWidth="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        IsOn="{x:Bind ViewModel.PreventSleepWhileRunning, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                </Grid>
            </Border>

            <!-- 日志 -->
            <Expander Margin="0,0,0,8" Style="{StaticResource CardExpanderStyle}">
                <Expander.Header>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="20"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE7C3;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="日志" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="管理日志文件与诊断行为"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="0">
                    <!-- 诊断模式 -->
                    <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xEBE8;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="诊断模式" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="开启后将记录更详细的日志（Debug 级），反馈问题前请先开启并复现"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.DiagnosticMode, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <Border
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" />

                    <!-- 打开日志目录 -->
                    <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE838;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="日志文件" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="在资源管理器中打开日志所在目录"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            MinWidth="120"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.OpenLogFolderCommand}"
                            Content="打开日志目录" />
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- 恢复设置 -->
            <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="20"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE777;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Text="恢复设置" TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="恢复应用程序的用户偏好设置，重置后须重启生效"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ResetSettingsCommand}"
                        Content="重置"
                        Style="{ThemeResource DefaultButtonStyle}" />
                </Grid>
            </Border>

            <!-- 关于 -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
                <FontIcon
                    Margin="0,0,8,0"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="18"
                    Glyph="&#xE946;" />
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="关于"
                    VerticalAlignment="Center" />
            </StackPanel>

            <Border
                Margin="0,0,0,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="8,8,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#1A6366F1" />
                                <GradientStop Offset="1" Color="#1A8B5CF6" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Padding="20,16" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="56"
                                Height="56"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="12">
                                <Image
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="ms-appx:///Assets/WindowIcon.ico" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="AutoHPMA" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <Border
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="White"
                                            Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="12"
                                        Text="稳定版" />
                                </StackPanel>
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                Content="检查更新"
                                IsEnabled="{x:Bind ViewModel.IsUpdateCheckEnabled, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,4,0,4">
                        <Grid Margin="20,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <FontIcon
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE77B;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="软件作者" />
                            </StackPanel>
                            <HyperlinkButton
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="Felix Christian"
                                NavigateUri="https://github.com/FelixHenrikChristian" />
                        </Grid>

                        <Border
                            Margin="20,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />

                        <Grid Margin="20,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <FontIcon
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE943;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="开源地址" />
                            </StackPanel>
                            <HyperlinkButton
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="GitHub"
                                NavigateUri="https://github.com/FelixHenrikChristian/AutoHPMA" />
                        </Grid>

                        <Border
                            Margin="20,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />

                        <Grid Margin="20,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <FontIcon
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8A1;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="使用教程" />
                            </StackPanel>
                            <HyperlinkButton
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="查看文档"
                                NavigateUri="https://autohpma.top/document/" />
                        </Grid>

                        <Border
                            Margin="20,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />

                        <Grid Margin="20,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <FontIcon
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8F2;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="问题反馈" />
                            </StackPanel>
                            <HyperlinkButton
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="提交 Issue"
                                NavigateUri="https://github.com/FelixHenrikChristian/AutoHPMA/issues" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                FontSize="12"
                Text="© 2024-2026 Felix Christian. 开源许可：MIT License" />
    </StackPanel>
</Page>
