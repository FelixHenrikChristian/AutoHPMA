<Page
    x:Class="AutoHPMA.Views.TestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="TestSelectorBar"
                     Grid.Row="0"
                     HorizontalAlignment="Left"
                     SelectionChanged="TestSelectorBar_SelectionChanged">
            <SelectorBarItem x:Name="ItemScreenshot" IsSelected="True" Text="截屏测试">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE722;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="ItemMouse" Text="鼠标模拟">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE962;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="ItemOcr" Text="文字识别">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE8D4;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="ItemTemplate" Text="模板匹配">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xF272;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="ItemContour" Text="轮廓检测">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE71E;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="ItemColor" Text="色彩过滤">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="ItemCoordinates" Text="坐标配置">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <Frame x:Name="ContentFrame"
               Grid.Row="1"
               IsNavigationStackEnabled="False" />
    </Grid>
</Page>

