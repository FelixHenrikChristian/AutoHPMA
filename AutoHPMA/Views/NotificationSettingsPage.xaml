<Page
    x:Class="AutoHPMA.Views.NotificationSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel Padding="{StaticResource NavigationViewPageContentPadding}">

            <!-- 通知设置 -->
            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                <FontIcon
                    Margin="0,0,8,0"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="18"
                    Glyph="&#xEA8F;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="通知设置" />
            </StackPanel>

            <!-- Windows 通知 Expander -->
            <Expander Margin="0,0,0,8" Style="{StaticResource CardExpanderStyle}">
                <Expander.Header>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="20"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xEA8F;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="Windows 通知" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="开启后，应用关键事件可通过系统通知中心提醒"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            Margin="0,0,12,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.NotificationEnabled, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="0">

                    <!-- 提示音 -->
                    <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE995;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="通知提示音" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="开启后通知会播放系统默认提示音"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.NotificationEnabled, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.NotificationSoundEnabled, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />

                    <!-- 测试通知 -->
                    <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE7C1;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="测试通知" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="点击发送一条示例通知，确认通知样式与提示音是否符合预期"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.TestNotificationCommand}"
                            Content="发送"
                            IsEnabled="{x:Bind ViewModel.NotificationEnabled, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>

