<Page
    x:Class="AutoHPMA.Views.TestPages.TaskCoordinateEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer
            Padding="0,16,8,8"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE713;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="任务坐标配置" />
                        </StackPanel>

                        <Border
                            Grid.Row="1"
                            Height="1"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <Grid
                            Grid.Row="2"
                            ColumnSpacing="12"
                            RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="配置文件" />
                            <TextBox
                                x:Name="ConfigFileText"
                                Grid.Row="0"
                                Grid.Column="1"
                                Height="34"
                                MinHeight="34"
                                IsReadOnly="True"
                                TextWrapping="NoWrap" />
                            <Button
                                Grid.Row="0"
                                Grid.Column="2"
                                Click="SelectFileButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                    <TextBlock Text="打开" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Row="0"
                                Grid.Column="3"
                                Click="ReloadButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                    <TextBlock Text="刷新" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Row="0"
                                Grid.Column="4"
                                Click="SaveButton_Click"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                    <TextBlock Text="保存" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="基准画面" />
                            <TextBlock
                                x:Name="CanonicalSizeText"
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="4"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE8B7;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="固定区域" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Click="AddRegionButton_Click"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE722;" />
                                    <TextBlock Text="截图画框" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Center" Text="ID" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="X" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="Y" />
                            <TextBlock Grid.Column="3" HorizontalAlignment="Center" Text="宽" />
                            <TextBlock Grid.Column="4" HorizontalAlignment="Center" Text="高" />
                            <TextBlock Grid.Column="5" HorizontalAlignment="Center" Text="框选" />
                            <TextBlock Grid.Column="6" HorizontalAlignment="Center" Text="删除" />
                        </Grid>

                        <ListView
                            x:Name="RegionsListView"
                            Grid.Row="2"
                            MinHeight="150"
                            Padding="0"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="0,5"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            PlaceholderText="task.region"
                                            Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Grid.Column="1"
                                            InputScope="Number"
                                            Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextAlignment="Center" />
                                        <TextBox
                                            Grid.Column="2"
                                            InputScope="Number"
                                            Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextAlignment="Center" />
                                        <TextBox
                                            Grid.Column="3"
                                            InputScope="Number"
                                            Text="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextAlignment="Center" />
                                        <TextBox
                                            Grid.Column="4"
                                            InputScope="Number"
                                            Text="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextAlignment="Center" />
                                        <Button
                                            Grid.Column="5"
                                            Width="34"
                                            Height="32"
                                            HorizontalAlignment="Center"
                                            MinWidth="0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Click="EditRegionButton_Click"
                                            ToolTipService.ToolTip="在游戏截图中重新框选">
                                            <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                        </Button>
                                        <Button
                                            Grid.Column="6"
                                            Width="34"
                                            Height="32"
                                            HorizontalAlignment="Center"
                                            MinWidth="0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Click="DeleteRegionButton_Click"
                                            ToolTipService.ToolTip="删除区域">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE81C;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="固定点" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Click="AddPointButton_Click"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE707;" />
                                    <TextBlock Text="截图取点" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Center" Text="ID" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="X" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="Y" />
                            <TextBlock Grid.Column="3" HorizontalAlignment="Center" Text="取点" />
                            <TextBlock Grid.Column="4" HorizontalAlignment="Center" Text="删除" />
                        </Grid>

                        <ListView
                            x:Name="PointsListView"
                            Grid.Row="2"
                            MinHeight="110"
                            Padding="0"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="0,5"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            PlaceholderText="task.point"
                                            Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Grid.Column="1"
                                            InputScope="Number"
                                            Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextAlignment="Center" />
                                        <TextBox
                                            Grid.Column="2"
                                            InputScope="Number"
                                            Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextAlignment="Center" />
                                        <Button
                                            Grid.Column="3"
                                            Width="34"
                                            Height="32"
                                            HorizontalAlignment="Center"
                                            MinWidth="0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Click="EditPointButton_Click"
                                            ToolTipService.ToolTip="在游戏截图中重新取点">
                                            <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                        </Button>
                                        <Button
                                            Grid.Column="4"
                                            Width="34"
                                            Height="32"
                                            HorizontalAlignment="Center"
                                            MinWidth="0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Click="DeletePointButton_Click"
                                            ToolTipService.ToolTip="删除固定点">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            x:Name="EditorInfoBar"
            Margin="0,0,8,8"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Page>
