<ContentDialog
    x:Class="AutoHPMA.Views.Dialogs.TermsOfUseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="使用条款"
    PrimaryButtonText="同意并继续"
    CloseButtonText="退出"
    DefaultButton="None"
    PrimaryButtonClick="OnPrimaryButtonClick"
    CloseButtonClick="OnCloseButtonClick"
    CornerRadius="8">

    <!-- 同意按钮：初始为带圆角的默认样式，滚到底部后在代码中切换为 AccentButtonStyle -->
    <ContentDialog.PrimaryButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.PrimaryButtonStyle>

    <!-- 退出按钮：始终带圆角 -->
    <ContentDialog.CloseButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.CloseButtonStyle>

    <!-- 将 ScrollViewer 和 TeachingTip 放在同一个 Grid 里 -->
    <Grid>
        <ScrollViewer
            x:Name="TermsScrollViewer"
            MaxHeight="420"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            ViewChanged="TermsScrollViewer_ViewChanged">
            <StackPanel Spacing="4" Padding="0,0,8,0">
                <!-- 欢迎语 -->
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="欢迎使用 AutoHPMA"
                    TextWrapping="Wrap"
                    Margin="0,0,0,4" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    LineHeight="22"
                    Text="在继续使用前，请阅读并理解以下条款。点击「同意并继续」即表示您接受全部内容。"
                    TextWrapping="Wrap"
                    Margin="0,0,0,16" />

                <!-- 条款卡片 1 -->
                <Border
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border
                                Padding="8,2"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="1" />
                            </Border>
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="用途与许可"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            LineHeight="24"
                            Text="本软件免费开源，仅供学习和研究使用，旨在为学术和研究人员提供参考和资料，任何其他目的均不适用。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 条款卡片 2 -->
                <Border
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border
                                Padding="8,2"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="2" />
                            </Border>
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="禁止行为与责任"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            LineHeight="24"
                            Text="严禁将本软件用于任何商业或非法用途。对于因违反此规定而产生的任何法律后果，用户需自行承担全部责任。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 条款卡片 3 -->
                <Border
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border
                                Padding="8,2"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="3" />
                            </Border>
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="资源与版权"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            LineHeight="24"
                            Text="软件目录下的资源信息均来源于网络。如有关于版权的争议或问题，请联系原作者或权利人。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 条款卡片 4 -->
                <Border
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border
                                Padding="8,2"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="4" />
                            </Border>
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="免责声明"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            LineHeight="24"
                            Text="由于用户计算机软硬件环境的差异性和复杂性，本软件所提供的各项功能并不能保证在任何情况下都能正常执行或达到用户所期望的结果。用户使用本软件所产生的一切后果，软件作者不承担任何责任。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 底部提示 -->
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    LineHeight="20"
                    Margin="2,4,0,8"
                    Text="若您不同意上述任一条款，请点击「退出」关闭应用程序。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- 未滚动到底部时点击同意按钮弹出的提示 -->
        <TeachingTip
            x:Name="ReadToEndTip"
            Title="温馨提示"
            Subtitle="请仔细阅读条款内容，阅读完方可同意。"
            IsLightDismissEnabled="True"
            PreferredPlacement="Top">
            <TeachingTip.IconSource>
                <SymbolIconSource Symbol="Important" />
            </TeachingTip.IconSource>
        </TeachingTip>
    </Grid>
</ContentDialog>
